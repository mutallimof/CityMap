{
  "name": "istanbul-living-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate:routes && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:coastline": "NODE_OPTIONS=--max-old-space-size=6000 tsx scripts/build-coastline.ts",
    "data:fetch-osm": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-osm.ts",
    "data:fetch-nominatim": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-nominatim.ts",
    "data:routes": "NODE_OPTIONS=--max-old-space-size=4096 tsx scripts/build-routes.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "data:fetch-places": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-places.ts",
    "data:places": "tsx scripts/build-places.ts",
    "data:piers": "tsx scripts/build-piers.ts",
    "data:landmarks": "NODE_USE_ENV_PROXY=1 tsx scripts/build-landmarks.ts",
    "data:stories": "tsx scripts/stories/build-stories.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "data:venues": "NODE_USE_ENV_PROXY=1 tsx scripts/build-venues.ts",
    "data:events": "NODE_USE_ENV_PROXY=1 tsx scripts/events/scrape.ts",
    "data:featured": "tsx scripts/build-featured.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@mapbox/point-geometry": "^1.1.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "maplibre-gl": "^6.13.0",
    "pbf": "^5.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@geo-maps/earth-lands-10m": "^0.6.0",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shapefile": "^0.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shapefile": "^0.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
