{
  "name": "istanbul-living-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:coastline": "NODE_OPTIONS=--max-old-space-size=6000 tsx scripts/build-coastline.ts",
    "data:fetch-osm": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-osm.ts",
    "data:piers": "tsx scripts/build-piers.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@geo-maps/earth-lands-10m": "^0.6.0",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
